# Managed by `zever new` and `zever add`. Copy to .env and fill secrets.
# Keys are <SERVICE>_<FIELD> (default instance) or <SERVICE>__<NAME>__<FIELD> (named).
# Defaults shown; every value re-parses via ApplyEnv. Tune instances with
# container.WithOptions entries in internal/app/wiring.go.

# --- db (adapter sqlite) ---
DB_ADAPTER=sqlite
DB_PATH=data/multidb.db

# --- db/analytics (adapter sqlite) ---
DB__ANALYTICS__ADAPTER=sqlite
DB__ANALYTICS__PATH=data/analytics.db

# --- db/audit (adapter sqlite) ---
DB__AUDIT__ADAPTER=sqlite
DB__AUDIT__PATH=data/audit.db

# --- log (adapter slog) ---
LOG_ADAPTER=slog

# --- router (adapter stdhttp) ---
ROUTER_ADAPTER=stdhttp
