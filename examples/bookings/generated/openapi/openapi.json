      "default_AddReviewRequest": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "format": "int64"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "default_Booking": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string"
          },
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "start_date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "default_CreateBookingRequest": {
        "type": "object",
        "properties": {
          "end_date": {
            "type": "string"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "start_date": {
            "type": "string"
          }
        }
      },
      "default_CreateSpaceRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "default_Review": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "rating": {
            "type": "integer",
            "format": "int64"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "default_Space": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "host_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ]
      },
      "default_User": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "password_hash": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
