# Managed by `zever new` and `zever add`. Copy to .env and fill secrets.
# Keys are <SERVICE>_<FIELD> (default instance) or <SERVICE>__<NAME>__<FIELD> (named).
# Defaults shown; every value re-parses via ApplyEnv. Adapter extras
# (e.g. CACHE_TABLE) follow the same SERVICE_FIELD rule; tune the rest
# with container.WithOptions in internal/app/wiring.go.

# --- analytics (adapter log) ---
ANALYTICS_ADAPTER=log

# --- auth (adapter jwt) ---
AUTH_ADAPTER=jwt
# AUTH_JWT_SECRET must be at least 32 bytes; never commit a real secret here.
# AUTH_JWT_SECRET=

# --- billing (adapter stub) ---
BILLING_ADAPTER=stub

# --- cache (adapter memory) ---
CACHE_ADAPTER=memory

# --- crypto (adapter local) ---
CRYPTO_ADAPTER=local

# --- db (adapter sqlite) ---
DB_ADAPTER=sqlite
DB_PATH=data/app.db

# --- document (adapter local) ---
DOCUMENT_ADAPTER=local

# --- eventbus (adapter memory) ---
EVENTBUS_ADAPTER=memory

# --- flag (adapter static) ---
FLAG_ADAPTER=static
FLAG_STATIC_PATH=flags.json

# --- geo (adapter static) ---
GEO_ADAPTER=static
GEO_PATH=data/cities.json

# --- i18n (adapter embed) ---
I18N_ADAPTER=embed

# --- idempotency (adapter memory) ---
IDEMPOTENCY_ADAPTER=memory

# --- lock (adapter memory) ---
LOCK_ADAPTER=memory

# --- log (adapter slog) ---
LOG_ADAPTER=slog

# --- mailer (adapter log) ---
MAILER_ADAPTER=log

# --- media (adapter local) ---
MEDIA_ADAPTER=local
MEDIA_ROOT=tmp/demo-media

# --- notification (adapter log) ---
NOTIFICATION_ADAPTER=log

# --- observability (adapter stdout) ---
OBSERVABILITY_ADAPTER=stdout

# --- outbox (adapter db) ---
OUTBOX_ADAPTER=db

# --- password (adapter argon2id) ---
PASSWORD_ADAPTER=argon2id

# --- payment (adapter stub) ---
PAYMENT_ADAPTER=stub

# --- permission (adapter rbac) ---
PERMISSION_ADAPTER=rbac

# --- queue (adapter memory) ---
QUEUE_ADAPTER=memory

# --- ratelimit (adapter memory) ---
RATELIMIT_ADAPTER=memory
RATELIMIT_RATE=10
RATELIMIT_BURST=20

# --- router (adapter stdhttp) ---
ROUTER_ADAPTER=stdhttp

# --- scheduler (adapter embedded) ---
SCHEDULER_ADAPTER=embedded

# --- search (adapter db) ---
SEARCH_ADAPTER=db
SEARCH_DSN=data/search.db

# --- secrets (adapter env) ---
SECRETS_ADAPTER=env

# --- session (adapter memory) ---
SESSION_ADAPTER=memory

# --- storage (adapter local) ---
STORAGE_ADAPTER=local
STORAGE_ROOT=tmp/demo-storage

# --- tenant (adapter single) ---
TENANT_ADAPTER=single

# --- vectorstore (adapter db) ---
VECTORSTORE_ADAPTER=db
VECTORSTORE_DSN=data/vectors.db
VECTORSTORE_DIMENSION=8

# --- webhook (adapter http) ---
WEBHOOK_ADAPTER=http

# --- workflow (adapter memory) ---
WORKFLOW_ADAPTER=memory
