# Managed by `zever new` and `zever add`. The service env keys this
# project reads, and the value each one runs with.
# Keys are <SERVICE>_<FIELD> (default instance) or <SERVICE>__<NAME>__<FIELD> (named).
# <FIELD> is the option's serialized name, upper-cased (DB_MAX_CONNS,
# AUTH_JWT_SECRET); the resolver matches case and "_" loosely, so both
# spellings reach the same option. Every value re-parses via ApplyEnv.
# Adapter extras (e.g. CACHE_TABLE) follow the same SERVICE_FIELD rule;
# tune the rest with container.WithOptions in internal/app/wiring.go.
# Secrets live in .env, which is never committed.

# CRYPTO_KEY is required outside a dev ZEVER_ENV: the local crypto adapter
# refuses the deterministic dev key. Generate one with:
#   head -c 32 /dev/urandom | base64
# CRYPTO_KEY=

# --- db (adapter sqlite) ---
DB_ADAPTER=sqlite
DB_PATH=data/app.db

# --- auth (adapter jwt) ---
AUTH_ADAPTER=jwt
# AUTH_JWT_SECRET must be at least 32 bytes; never commit a real secret here.
# AUTH_JWT_SECRET=

# --- cache (adapter memory) ---
CACHE_ADAPTER=memory

# --- log (adapter slog) ---
LOG_ADAPTER=slog

# --- observability (adapter stdout) ---
OBSERVABILITY_ADAPTER=stdout

# --- password (adapter argon2id) ---
PASSWORD_ADAPTER=argon2id

# --- queue (adapter memory) ---
QUEUE_ADAPTER=memory

# --- router (adapter stdhttp) ---
ROUTER_ADAPTER=stdhttp

# --- scheduler (adapter embedded) ---
SCHEDULER_ADAPTER=embedded

# --- ratelimit (adapter memory) ---
RATELIMIT_ADAPTER=memory
RATELIMIT_RATE=10
RATELIMIT_BURST=20
RATELIMIT_IDLE_TTL=0s
RATELIMIT_SWEEP_INTERVAL=0s
RATELIMIT_MAX_ENTRIES=0
RATELIMIT_REDIS_PREFIX=
