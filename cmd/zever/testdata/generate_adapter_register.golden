package memcached

import (
	"github.com/zenta-dev/zever/core/cache"
)

// Register wires this adapter into its battery registry. Call from your app's main or generated app.go; no init magic.
//
// SCAFFOLD: Memcached does not exist yet -- add it to the cache Adapter
// enum (plus its ParseAdapter case) as part of the manual wiring, then
// replace the ParseAdapter call below with the constant.
func Register() {
	adapter, _ := cache.ParseAdapter("memcached")
	_ = cache.Register(adapter, New)
}
