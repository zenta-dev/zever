package acme

import (
	"time"
)

// Options configures the acme storage adapter.
type Options struct {
	// APIKey is the "api_key" option. TODO: document it.
	APIKey string `json:"api_key"`
	// Timeout is the "timeout" option. TODO: document it.
	Timeout time.Duration `json:"timeout"`
	// MaxRetries is the "max_retries" option. TODO: document it.
	MaxRetries int `json:"max_retries"`
	// Endpoints is the "endpoints" option. TODO: document it.
	Endpoints []string `json:"endpoints"`
	// UseTLS is the "use_tls" option. TODO: document it.
	UseTLS bool `json:"use_tls"`
	// Extra is the "extra" option. TODO: document it.
	Extra map[string]any `json:"extra"`
}

// fieldOr returns the T held at key, or def when the key is missing or held
// a different type. It keeps ParseOptions stdlib-only, so the stub compiles
// inside its own adapter module with no shared helpers to import.
func fieldOr[T any](m map[string]any, key string, def T) T {
	if v, ok := m[key].(T); ok {
		return v
	}

	return def
}

// ParseOptions extracts typed options from a raw configuration map.
//
// TODO: add the required-field checks this adapter needs: an empty value
// that the adapter cannot run without should fail here with a
// "[storage] acme: <field> is required" error, not at first use.
func ParseOptions(m map[string]any) (Options, error) {
	var o Options

	o.APIKey = fieldOr[string](m, "api_key", "")
	o.Timeout = fieldOr[time.Duration](m, "timeout", 0)
	o.MaxRetries = fieldOr[int](m, "max_retries", 0)
	o.Endpoints = fieldOr[[]string](m, "endpoints", nil)
	o.UseTLS = fieldOr[bool](m, "use_tls", false)
	o.Extra = fieldOr[map[string]any](m, "extra", nil)

	return o, nil
}
