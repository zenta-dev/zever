package acme

import (
	"time"

	"github.com/zenta-dev/zever/internal/opts"
)

// Options configures the acme storage adapter.
type Options struct {
	// APIKey is the "api_key" option. TODO: document it.
	APIKey string `json:"api_key" toml:"api_key" yaml:"api_key"`
	// Timeout is the "timeout" option. TODO: document it.
	Timeout time.Duration `json:"timeout" toml:"timeout" yaml:"timeout"`
	// MaxRetries is the "max_retries" option. TODO: document it.
	MaxRetries int `json:"max_retries" toml:"max_retries" yaml:"max_retries"`
	// Endpoints is the "endpoints" option. TODO: document it.
	Endpoints []string `json:"endpoints" toml:"endpoints" yaml:"endpoints"`
	// UseTLS is the "use_tls" option. TODO: document it.
	UseTLS bool `json:"use_tls" toml:"use_tls" yaml:"use_tls"`
	// Extra is the "extra" option. TODO: document it.
	Extra map[string]any `json:"extra" toml:"extra" yaml:"extra"`
}

// ParseOptions extracts typed options from a raw configuration map.
//
// TODO: add the required-field checks this adapter needs, in the style of the
// other adapters: an empty value that the adapter cannot run without should
// fail here with a "[storage] acme: <field> is required" error, not
// at first use.
func ParseOptions(m map[string]any) (Options, error) {
	var o Options

	o.APIKey = opts.String(m, "api_key", "")
	o.Timeout = opts.Duration(m, "timeout", 0)
	o.MaxRetries = opts.Int(m, "max_retries", 0)
	o.Endpoints = opts.StringSlice(m, "endpoints")
	o.UseTLS = opts.Bool(m, "use_tls", false)
	o.Extra = opts.Map(m, "extra")

	return o, nil
}
