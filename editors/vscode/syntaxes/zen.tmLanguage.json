{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zen",
  "scopeName": "source.zen",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#types" },
    { "include": "#labels" },
    { "include": "#attributes" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zen",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.zen",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zen",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.zen",
          "match": "\\b\\d+(ns|us|µs|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.zen",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.zen",
      "match": "\\b(belongs_to|entity|enum|has_many|has_one|index|job|many_to_many|message|rpc|schedule|service)\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.zen",
      "match": "\\b(true|false)\\b"
    },
    "types": {
      "name": "support.type.zen",
      "match": "\\b(bool|bytes|date|float32|float64|int32|int64|json|string|timestamp|uuid)\\b"
    },
    "labels": {
      "name": "variable.parameter.zen",
      "match": "\\b(http|auth|permission|queue|retry|cron|dispatch|join_table|foreign_key|on_delete|validate|default|primary|unique|required|GET|POST|PUT|PATCH|DELETE)\\b"
    },
    "attributes": {
      "name": "entity.other.attribute-name.zen",
      "match": "@\\w+"
    },
    "operators": {
      "name": "keyword.operator.zen",
      "match": "->"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.tag.zen",
          "match": "[{}()]"
        }
      ]
    }
  }
}
