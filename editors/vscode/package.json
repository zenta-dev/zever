{
  "name": "zever-dsl",
  "displayName": "Zever DSL",
  "description": "Syntax highlighting and language server client integration for the zever schema DSL (.zen files)",
  "version": "0.8.0",
  "publisher": "zenta-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenta-dev/zever.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zen"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zen",
        "aliases": [
          "Zen",
          "zen"
        ],
        "extensions": [
          ".zen"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zen",
        "scopeName": "source.zen",
        "path": "./syntaxes/zen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zen",
        "path": "./snippets/zen.json"
      }
    ],
    "configuration": {
      "title": "Zever",
      "properties": {
        "zever.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace level for the zever language server communication."
        },
        "zever.serverPath": {
          "type": "string",
          "default": "zever-lsp",
          "description": "Path to the zever-lsp executable."
        },
        "zever.inlayHints.implicitModule": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay hints for implicit module references."
        },
        "zever.inlayHints.errorCases": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay hints for error cases."
        }
      }
    },
    "commands": [
      {
        "command": "zever.restartServer",
        "title": "Zever: Restart Language Server"
      },
      {
        "command": "zever.validate",
        "title": "Zever: Validate Current File"
      },
      {
        "command": "zever.fixAll",
        "title": "Zever: Fix All Issues in Current File"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zever.restartServer"
        },
        {
          "command": "zever.validate",
          "when": "editorLangId == zen"
        },
        {
          "command": "zever.fixAll",
          "when": "editorLangId == zen"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/extension.test.js",
    "test:grammar": "textmate-grammar-snap --grammar ./syntaxes/zen.tmLanguage.json --scope source.zen \"test/grammar/**/*.zen\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.91.0",
    "@types/node": "^20.11.0",
    "textmate-grammar-test": "^0.7.0"
  }
}
