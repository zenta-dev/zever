---
import logo from '../../assets/logo.svg';
import { href } from '../../lib/url';
---

<a href={href('start/introduction')} class="zv-brand" aria-label="Zever docs home">
  <img src={logo.src} alt="" width="28" height="28" />
  <span translate="no">Zever</span>
</a>

<style is:global>
  .zv-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 2.75rem; font: 600 1.05rem/1 var(--zl-font-display); letter-spacing: -0.02em; color: var(--zl-text); text-decoration: none; white-space: nowrap; }
  .zv-brand img { width: 28px; height: 28px; }
</style>
