---
import '../../styles/docs/page.css';
interface Props { id: string }
const { id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mdPath = `${base}/${id}.md`;
const abs = new URL(mdPath, Astro.site ?? 'https://zenta-dev.github.io').href;
const q = encodeURIComponent(`Read ${abs} and help me with Zever.`);
---

<div class="zp-actions" data-md={mdPath}>
  <div class="zp-split">
    <button type="button" class="zp-copy" data-copy>
      <svg class="zp-ico zp-ico-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
      <svg class="zp-ico zp-ico-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span data-copy-label>Copy page</span>
    </button>
    <button type="button" class="zp-more" data-trigger aria-haspopup="menu" aria-expanded="false" aria-label="More page actions">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>
  <div class="zp-menu" role="menu" aria-label="Page actions" hidden data-menu>
    <a role="menuitem" tabindex="-1" href={mdPath} target="_blank" rel="noopener">View as Markdown</a>
    <a role="menuitem" tabindex="-1" href={`https://claude.ai/new?q=${q}`} target="_blank" rel="noopener">Open in Claude</a>
    <a role="menuitem" tabindex="-1" href={`https://chatgpt.com/?q=${q}`} target="_blank" rel="noopener">Open in ChatGPT</a>
  </div>
  <span class="zp-sr" role="status" aria-live="polite" data-live></span>
</div>

<script>
  import '../../scripts/docs/page-actions.ts';
</script>
