---
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import { GROUP_TAB } from './NavRoute';

type Entry = any;
interface Props { sublist: Entry[]; nested?: boolean }
const { sublist, nested } = Astro.props;

const flat = (es: Entry[]): Entry[] => es.flatMap((e) => (e.type === 'group' ? flat(e.entries) : [e]));

// Inline 24px stroke icons, one per top-level group label.
const ICONS: Record<string, string> = {
  'Getting Started': '<path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2"/><path d="M12 15l-3-3a22 22 0 0 1 2-4 12 12 0 0 1 11-5c0 3-1 8-5 11a22 22 0 0 1-5 1Z"/><path d="M9 12H4s.6-3 2-4c1.6-1 5 0 5 0M12 15v5s3-.6 4-2c1-1.6 0-5 0-5"/>',
  Tutorials: '<path d="M2 6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H2ZM22 6a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h8Z"/>',
  Architecture: '<path d="M12 2 3 7l9 5 9-5-9-5Z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/>',
  Basics: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  'Schema DSL (.zen)': '<path d="m8 8-5 4 5 4M16 8l5 4-5 4M14 4l-4 16"/>',
  'Database & ORM': '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  'Digging Deeper': '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M11 8v6M8 11h6"/>',
  Security: '<path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  Reference: '<path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4Z"/><path d="M8 9h8M8 13h6"/>',
  Contribute: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8Z"/>',
};
ICONS.Start = ICONS['Getting Started'];
ICONS['HTTP APIs'] = '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>';
ICONS['Data and storage'] = ICONS['Database & ORM'];
ICONS['Background work'] = '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>';
ICONS.Operate = '<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>';
ICONS.Integrations = '<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0V8ZM12 18v4"/>';
ICONS.Extend = '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z"/>';
ICONS.Concepts = ICONS.Architecture;
const FALLBACK = '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9"/>';
---

<ul class:list={{ 'zv-list': true, 'zv-top': !nested }}>
  {sublist.map((entry) => (
    <li data-tab-of={!nested ? GROUP_TAB[entry.label] : undefined}>
      {entry.type === 'link' ? (
        <a
          href={entry.href}
          aria-current={entry.isCurrent ? 'page' : undefined}
          class:list={[{ 'zv-top-link': !nested }, entry.attrs?.class]}
        >
          <span>{entry.label}</span>
          {entry.badge && <span class="zv-badge">{entry.badge.text}</span>}
        </a>
      ) : (
        <details open={flat(entry.entries).some((i) => i.isCurrent) || !entry.collapsed} class:list={{ 'zv-group': !nested }}>
          <summary>
            {!nested && (
              <svg class="zv-gicon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[entry.label] ?? FALLBACK} />
            )}
            <span class="zv-glabel">{entry.label}</span>
            <svg class="zv-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <SidebarRestorePoint />
          <Astro.self sublist={entry.entries} nested />
        </details>
      )}
    </li>
  ))}
</ul>
