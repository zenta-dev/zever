---
import { ClientRouter } from 'astro:transitions';
import Default from '@astrojs/starlight/components/Head.astro';
import fontUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { SITE, NAME, KEYWORDS, abs, docsGraph, jsonLd, type Crumb } from '../../lib/seo';

const route = Astro.locals.starlightRoute;
const id = route.entry.id;
const { title, description = '' } = route.entry.data;
const md = abs(`${id}.md`);
const url = abs(`${id}/`);
const image = abs(`og/${id}.png`);

// Breadcrumb group label: the sidebar group that contains the current page.
type Entry = { type: string; label: string; isCurrent?: boolean; entries?: Entry[] };
const hasCurrent = (e: Entry): boolean => (e.type === 'link' ? !!e.isCurrent : !!e.entries?.some(hasCurrent));
const group = (route.sidebar as Entry[]).find((e) => e.type === 'group' && hasCurrent(e));
const crumbs: Crumb[] = [{ name: NAME, url: `${SITE}/` }, { name: 'Docs', url: abs('getting-started/introduction/') }];
if (group && group.label !== title) crumbs.push({ name: group.label, url });
crumbs.push({ name: title, url });
---

<Default {...Astro.props}><slot /></Default>
<meta name="keywords" content={KEYWORDS} />
<meta name="author" content="Zenta Dev" />
<meta name="robots" content={id === '404' ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} | ${NAME} docs`} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={`${title} | ${NAME} docs`} />
<link rel="alternate" type="text/markdown" href={md} title={`${title} (Markdown)`} />
<link rel="alternate" type="text/plain" href={abs('llms.txt')} title="llms.txt" />
<link rel="icon" href={`${import.meta.env.BASE_URL}icon-192.png`} type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
<link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#05070d" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />
<script type="application/ld+json" is:inline set:html={jsonLd(docsGraph({ title, description, url, image, crumbs }))} />
<ClientRouter />
<script>
  import '../../scripts/scroll-state';
</script>
