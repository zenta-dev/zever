---
interface Props { title?: string; class?: string }
const { title = '', class: cls = '' } = Astro.props;
---

<figure class:list={['zl-win', cls]}>
  <figcaption class="zl-win-bar">
    <span class="zl-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="zl-win-title">{title}</span>
    <slot name="actions" />
  </figcaption>
  <div class="zl-win-body"><slot /></div>
</figure>

<style is:global>
  .zl-win { margin: 0; border: 1px solid var(--zl-line-strong); border-radius: var(--zl-radius); background: var(--zl-code-bg); box-shadow: var(--zl-shadow); overflow: hidden; color: #e6edf7; }
  .zl-win-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.08); font: 0.75rem/1 var(--zl-font-mono); color: #8896ab; }
  .zl-dots { display: inline-flex; gap: 6px; }
  .zl-dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.14); }
  .zl-win-title { margin-right: auto; }
  .zl-win-body { padding: 1rem 1.1rem; font: 0.82rem/1.65 var(--zl-font-mono); overflow-x: hidden; }
  .zl-win-body pre { margin: 0; background: transparent !important; padding: 0; white-space: pre-wrap; overflow-wrap: anywhere; word-break: normal; tab-size: 2; }
  .zl-win-body pre code, .zl-win-body code { white-space: pre-wrap; overflow-wrap: anywhere; }
  .zl-win-body pre code .line, .zl-win-body pre code span.line { white-space: pre-wrap; }
  .zl-win-body code { font: inherit; background: none; }
</style>
