---
import { NAV } from '../../data/landing';
import { href, GITHUB } from '../../lib/url';
import logo from '../../assets/logo.svg';
import ScrollProgress from './ScrollProgress.astro';
import StickyCta from './StickyCta.astro';

// In-page anchors (section ids on index.astro) get active highlighting; docs links are plain.
const SECTIONS = [
  { label: 'How it works', id: 'walkthrough' },
  { label: 'Adapters', id: 'swap' },
  { label: 'Batteries', id: 'batteries' },
  { label: 'Agents', id: 'agents' },
  { label: 'Examples', id: 'examples' },
  { label: 'FAQ', id: 'faq' },
];
const docsLink = NAV[0];
const more = NAV.slice(1).filter((n) => n.label !== 'Examples');
---

<header class="zl-nav" data-nav>
  <div class="zl-wrap zl-nav-in">
    <a class="zl-nav-brand" href={href('')} aria-label="Zever home"><img src={logo.src} alt="" width="28" height="28" /><span>Zever</span></a>
    <nav class="zl-nav-links" aria-label="Primary">
      {SECTIONS.map((s) => <a class="zl-nl" href={`#${s.id}`} data-section={s.id}>{s.label}</a>)}
      <a class="zl-nl" href={href(docsLink.href)}>{docsLink.label}</a>
      <a class="zl-nl" href={GITHUB} rel="noopener">GitHub</a>
    </nav>
    <div class="zl-nav-end">
      <button type="button" class="zl-icon-btn" data-theme-toggle aria-label="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="zl-btn zl-btn-primary zl-nav-cta" href={href('start/installation')}>Get started</a>
      <button type="button" class="zl-icon-btn zl-nav-burger" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="zl-sheet">
        <span class="zl-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="zl-sheet" id="zl-sheet" role="dialog" aria-modal="true" aria-label="Menu" data-sheet inert>
  <nav class="zl-sheet-links" aria-label="Mobile">
    {SECTIONS.map((s, i) => <a href={`#${s.id}`} data-section={s.id} style={`--i:${i}`}>{s.label}</a>)}
    <a href={href(docsLink.href)} style={`--i:${SECTIONS.length}`}>{docsLink.label}</a>
    {more.map((n, i) => <a href={href(n.href)} style={`--i:${SECTIONS.length + 1 + i}`}>{n.label}</a>)}
    <a href={GITHUB} rel="noopener" style={`--i:${SECTIONS.length + 1 + more.length}`}>GitHub</a>
  </nav>
  <a class="zl-btn zl-btn-primary zl-sheet-cta" href={href('start/installation')} style={`--i:${SECTIONS.length + 2 + more.length}`}>Get started</a>
</div>

<ScrollProgress />
<StickyCta />

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const onScroll = () => nav?.classList.toggle('is-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile overlay: animated open/close, focus trap, Esc, scroll lock.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const setOpen = (open: boolean, restore = true) => {
    if (!toggle || !sheet) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    sheet.classList.toggle('is-open', open);
    nav?.classList.toggle('is-menu', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) { sheet.removeAttribute('inert'); sheet.querySelector<HTMLElement>('a')?.focus({ preventScroll: true }); }
    else { sheet.setAttribute('inert', ''); if (restore) toggle.focus({ preventScroll: true }); }
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false, false)));
  document.addEventListener('keydown', (e) => {
    if (!sheet?.classList.contains('is-open') || !toggle) return;
    if (e.key === 'Escape') { e.preventDefault(); setOpen(false); return; }
    if (e.key !== 'Tab') return;
    const items = [toggle, ...sheet.querySelectorAll<HTMLElement>('a[href]')];
    const i = items.indexOf(document.activeElement as HTMLElement);
    const next = e.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : (i === items.length - 1 ? 0 : i + 1);
    e.preventDefault();
    items[next].focus();
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', (m) => { if (m.matches) setOpen(false, false); });

  // Active section highlight.
  const links = new Map<string, HTMLElement[]>();
  document.querySelectorAll<HTMLElement>('[data-section]').forEach((a) => {
    const id = a.dataset.section!;
    links.set(id, [...(links.get(id) ?? []), a]);
  });
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const mark = () => {
      // The first (top-most in document order) section crossing the viewport band wins.
      const cur = targets.find((t) => visible.has(t.id))?.id;
      links.forEach((els, id) => els.forEach((el) => {
        if (id === cur) el.setAttribute('aria-current', 'location'); else el.removeAttribute('aria-current');
      }));
    };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      mark();
    }, { rootMargin: '-40% 0px -55% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style is:global>
  .zl-nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent; transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s; }
  .zl-nav.is-stuck { background: color-mix(in srgb, var(--zl-bg) 78%, transparent); backdrop-filter: blur(14px) saturate(1.4); border-color: var(--zl-line); }
  .zl-nav.is-menu { background: var(--zl-bg); border-color: var(--zl-line); }
  .zl-nav-in { display: flex; align-items: center; gap: 2rem; height: 3.75rem; }
  .zl-nav-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 2.75rem; font: 600 1.05rem/1 var(--zl-font-sans); letter-spacing: -0.02em; }
  .zl-nav-links { display: flex; gap: 0.25rem; margin-right: auto; font-size: 0.9rem; color: var(--zl-text-2); }
  .zl-nl { position: relative; display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.7rem; transition: color 0.2s; }
  .zl-nl::after { content: ''; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0.55rem; height: 2px; border-radius: 2px; background: var(--zl-btn-grad); transform: scaleX(0); transform-origin: 100% 50%; transition: transform 0.35s var(--zl-ease); }
  .zl-nl:hover, .zl-nl[aria-current] { color: var(--zl-text); }
  .zl-nl:hover::after, .zl-nl[aria-current]::after { transform: scaleX(1); transform-origin: 0 50%; }
  .zl-nav-end { display: flex; align-items: center; gap: 0.5rem; }
  .zl-nav-cta { min-height: 2.75rem; font-size: 0.85rem; padding: 0 1.1rem; }
  .zl-icon-btn { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--zl-line); background: var(--zl-surface); color: var(--zl-text-2); cursor: pointer; transition: color 0.2s, border-color 0.2s; -webkit-tap-highlight-color: transparent; }
  .zl-icon-btn:hover { color: var(--zl-text); border-color: var(--zl-line-strong); }
  .zl-nav-burger { display: none; }
  .zl-bars { position: relative; width: 18px; height: 14px; display: block; }
  .zl-bars i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.35s var(--zl-ease), opacity 0.2s; }
  .zl-bars i:nth-child(1) { top: 0; } .zl-bars i:nth-child(2) { top: 6px; } .zl-bars i:nth-child(3) { top: 12px; }
  [aria-expanded='true'] .zl-bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .zl-bars i:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .zl-bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .zl-sheet { display: none; }
  @media (max-width: 900px) {
    .zl-nav-links, .zl-nav .zl-nav-cta { display: none; }
    .zl-nav-burger { display: grid; }
    .zl-nav-in { gap: 1rem; }
    .zl-nav-end { margin-left: auto; }
    .zl-sheet { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; position: fixed; z-index: 49; inset: 0; padding: calc(3.75rem + 1.5rem) var(--zl-gutter) calc(1.5rem + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; background: var(--zl-bg); visibility: hidden; opacity: 0; transform: translateY(-1.5rem); transition: opacity 0.3s, transform 0.45s var(--zl-ease), visibility 0s 0.45s; }
    .zl-sheet.is-open { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .zl-sheet-links { display: flex; flex-direction: column; }
    .zl-sheet-links a { display: flex; align-items: center; justify-content: space-between; min-height: 3.5rem; border-bottom: 1px solid var(--zl-line); font: 600 clamp(1.5rem, 7vw, 2.25rem)/1.1 var(--zl-font-display); letter-spacing: -0.03em; color: var(--zl-text); opacity: 0; transform: translateY(1rem); transition: opacity 0.35s, transform 0.5s var(--zl-ease), color 0.2s; }
    .zl-sheet.is-open .zl-sheet-links a, .zl-sheet.is-open .zl-sheet-cta { opacity: 1; transform: none; transition-delay: calc(80ms + var(--i) * 45ms); }
    .zl-sheet-links a[aria-current] { color: var(--zl-accent); }
    .zl-sheet .zl-sheet-cta { transition: opacity 0.35s, transform 0.5s var(--zl-ease), box-shadow 0.25s; }
    .zl-sheet-cta { width: 100%; min-height: 3.25rem; font-size: 1.05rem; opacity: 0; transform: translateY(1rem); }
  }
  @media (min-width: 1200px) { .zl-nav-links { gap: 0.5rem; } }
  @media (prefers-reduced-motion: reduce) {
    .zl-sheet, .zl-sheet-links a, .zl-sheet-cta { transition: none !important; transform: none !important; }
    .zl-sheet-links a, .zl-sheet-cta { opacity: 1 !important; }
  }
</style>
