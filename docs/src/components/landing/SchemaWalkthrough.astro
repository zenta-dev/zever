---
import fs from 'node:fs';
import { Code } from 'astro:components';
import Section from './ui/Section.astro';
import CodeWindow from './ui/CodeWindow.astro';
import Button from './ui/Button.astro';
import { ZEN_SOURCE } from '../../data/landing';
import { href } from '../../lib/url';

const zen = JSON.parse(fs.readFileSync('../editors/vscode/syntaxes/zen.tmLanguage.json', 'utf-8'));

const orm = `// Code generated by the zever DSL zenorm backend. DO NOT EDIT.
package app

import (
	"time"

	"github.com/zenta-dev/zever/orm"
)

// Tasks is the orm.Table for Task, generated from the "Task" entity.
var Tasks = orm.NewTable[Task]("tasks", []string{"id", "title", "done", "created_at"})

// TaskCols holds typed column references for Task.
var TaskCols = struct {
	ID        orm.Column[Task, string]
	Title     orm.Column[Task, string]
	Done      orm.Column[Task, bool]
	CreatedAt orm.Column[Task, time.Time]
}{
	ID:        orm.NewColumn[Task, string]("tasks", "id"),
	Title:     orm.NewColumn[Task, string]("tasks", "title"),
	Done:      orm.NewColumn[Task, bool]("tasks", "done"),
	CreatedAt: orm.NewColumn[Task, time.Time]("tasks", "created_at"),
}

// Task mirrors the "Task" entity declared in the schema.
type Task struct {
	ID        string    \`json:"id"\`
	Title     string    \`json:"title"\`
	Done      bool      \`json:"done"\`
	CreatedAt time.Time \`json:"created_at"\`
}
`;

const openapi = `{
  "openapi": "3.0.3",
  "info": { "title": "zever API", "version": "0.0.0" },
  "paths": {
    "/v1/tasks": {
      "post": {
        "operationId": "TaskService_CreateTask",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/default_TaskServiceCreateTaskRequest" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/default_Task" } } }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "get": {
        "operationId": "TaskService_ListTasks",
        "security": [{ "bearerAuth": [] }]
      }
    }
  }
}
`;

const hcl = `table "tasks" {
  schema = schema.public
  column "id" {
    null = false
    type = uuid
  }
  column "title" {
    null = false
    type = varchar(200)
  }
  column "done" {
    null = false
    type = boolean
  }
  column "created_at" {
    null = false
    type = timestamptz
  }
  primary_key {
    columns = [column.id]
  }
}
`;

const handler = `// You write this. Zever resolved the pool.
func (s *TaskService) CreateTask(ctx context.Context, req *app.CreateTaskRequest) (*app.Task, error) {
	db, err := s.c.DB() // sqlite today, postgres by config
	if err != nil {
		return nil, err
	}
	t := &app.Task{ID: uuid.NewString(), Title: req.Title, CreatedAt: time.Now().UTC()}
	err = orm.InsertInto(app.Tasks).Values(
		orm.Set(app.TaskCols.ID, t.ID),
		orm.Set(app.TaskCols.Title, t.Title),
		orm.Set(app.TaskCols.Done, false),
		orm.Set(app.TaskCols.CreatedAt, t.CreatedAt),
	).Exec(ctx, db)
	return t, err
}
`;

const term = `$ zever generate
wrote orm, openapi, atlas, routes
$ zever db migrate
applied schema.hcl
$ zever serve
listening on :8080
$ curl -X POST localhost:8080/v1/tasks -d '{"title":"ship"}'
{"id":"7c1e...","title":"ship","done":false}
`;

const tabs = [
  { id: 'zen', file: 'app.zen', step: 0, code: ZEN_SOURCE, lang: zen as any },
  { id: 'orm', file: 'task.zenorm.go', step: 1, code: orm, lang: 'go' },
  { id: 'openapi', file: 'openapi.json', step: 1, code: openapi, lang: 'json' },
  { id: 'hcl', file: 'schema.hcl', step: 1, code: hcl, lang: 'hcl' },
  { id: 'handler', file: 'handler.go', step: 2, code: handler, lang: 'go' },
  { id: 'term', file: 'terminal', step: 3, code: term, lang: 'bash' },
];

const steps = [
  { n: 'Describe', t: 'Describe the schema', d: 'Entities and services in a small .zen file. Validation, defaults and HTTP bindings live next to the types.' },
  { n: 'Compile', t: 'Compile the plumbing', d: 'One command emits the typed ORM, the OpenAPI spec and the migration DDL, all from the same source of truth.' },
  { n: 'Wire', t: 'Wire through the container', d: 'Your handler asks the container for what it needs. The adapter behind c.DB() is a config line, not a code change.' },
  { n: 'Serve', t: 'Serve it', d: 'Migrate, serve, call. Business logic stays yours; the infrastructure was never your problem.' },
];
---

<Section
  id="walkthrough"
  eyebrow="Schema to server"
  title="From a <em>schema</em> to a running API in four steps."
>
  <div class="sw" data-walkthrough>
    <div class="sw-col">
      <div class="sw-prog" aria-hidden="true">
        <span class="sw-prog-fill"></span>
        {steps.map((_, i) => <span class="sw-dot" style={`--k:${i / (steps.length - 1)}`}></span>)}
      </div>
      <ol class="sw-rail" aria-label="Steps">
        {steps.map((s, i) => (
          <li class="sw-step" data-step={i} style={`--i:${i}`} aria-current={i === 0 ? 'step' : undefined}>
            <button type="button" class="sw-step-btn" data-step-btn={i}>
              <span class="sw-num">0{i + 1}</span>
              <span class="sw-name">{s.n}</span>
            </button>
            <div class="sw-copy">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="sw-mdesc" data-sw-desc>{steps[0].d}</p>
    </div>

    <div class="sw-pane">
      <CodeWindow title="schema to server">
        <button type="button" slot="actions" class="zl-copy" data-copy aria-label="Copy code of the selected file"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect class="c-a" x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path class="c-a" d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5"/><path class="c-b" d="M3 8.5l3.2 3.2L13 4.8"/></svg></button>
        <span slot="actions" class="sw-sr" role="status" aria-live="polite" data-copy-status></span>
        <span slot="actions" class="sw-sr" role="status" aria-live="polite" data-sw-status></span>
        <div slot="actions" class="sw-tabs" role="tablist" aria-label="Files">
          <span class="sw-pill" aria-hidden="true"></span>
          {tabs.map((t, i) => (
            <button type="button" role="tab" class="sw-tab" id={`sw-tab-${t.id}`} aria-controls={`sw-panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id} data-step={t.step}>
              {t.file}
            </button>
          ))}
        </div>
        <div class="sw-panels">
          {tabs.map((t, i) => (
            <div role="tabpanel" class:list={['sw-panel', i === 0 && 'is-active']} id={`sw-panel-${t.id}`} aria-labelledby={`sw-tab-${t.id}`} data-panel={t.id}>
              <div class="sw-file">{t.file}</div>
              <Code code={t.code} lang={t.lang} theme="github-dark-default" />
            </div>
          ))}
        </div>
      </CodeWindow>
    </div>
  </div>

  <div class="sw-cta">
    <Button href={href('tutorials/build-a-booking-api')}>Build your first API</Button>
    <Button variant="ghost" href={href('reference/zen-syntax')}>Read the DSL docs</Button>
  </div>
</Section>

<script>
  import { initWalkthrough } from '../../scripts/landing/walkthrough';
  initWalkthrough();
</script>

<style is:global>
  .sw { --sw-prog: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .sw-col { min-width: 0; position: relative; }
  .sw-prog { display: none; }
  .sw-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Steps: compact horizontal chips on mobile, never sticky. */
  .sw-rail { list-style: none; margin: 0; padding: 0.25rem 0; display: flex; gap: 0.5rem; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent); mask-image: linear-gradient(90deg, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent); }
  .sw-rail::-webkit-scrollbar, .sw-tabs::-webkit-scrollbar { display: none; }
  .sw-step { flex: 0 0 auto; scroll-snap-align: center; }
  .sw-step-btn { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; gap: 0.5rem; align-items: baseline; min-height: 2.75rem; align-items: center; padding: 0 1rem; border: 1px solid var(--zl-line); border-radius: 99px; color: var(--zl-text-2); font: 500 0.85rem var(--zl-font-sans); transition: color 0.25s, border-color 0.25s, background 0.25s; }
  .sw-step-btn:hover { color: var(--zl-text); border-color: var(--zl-line-strong); }
  .sw-step-btn:focus-visible { outline: 2px solid var(--zl-accent); outline-offset: 2px; }
  .sw-num { font: 0.7rem var(--zl-font-mono); color: var(--zl-text-3); }
  .sw-step[aria-current='step'] .sw-step-btn { color: var(--zl-text); border-color: var(--zl-accent); background: var(--zl-surface-2); }
  .sw-copy { display: none; }
  .sw-mdesc { margin: 0.5rem 0 0; color: var(--zl-text-2); font-size: 0.92rem; min-height: 3em; }
  html:not(.zl-js) .sw-rail, html:not(.zl-js) .sw-mdesc { display: none; }

  .sw-pane { min-width: 0; }
  .sw .zl-win-bar { flex-wrap: wrap; row-gap: 0.4rem; padding-bottom: 0; }
  .sw .zl-win-title { display: none; }
  .sw .zl-dots { margin-right: auto; }

  /* Tabs: own row, horizontal scroll + snap + edge fades, 44px targets, shared sliding pill. */
  .sw-tabs { display: none; order: 3; flex: 1 0 100%; position: relative; gap: 0.25rem; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; margin: 0 -0.9rem; padding: 0 0.9rem 0.4rem; max-width: calc(100% + 1.8rem); }
  .zl-js .sw-tabs { display: flex; }
  .sw-tabs.fade-end { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent); }
  .sw-tabs.fade-start { -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5rem); mask-image: linear-gradient(90deg, transparent, #000 2.5rem); }
  .sw-tabs.fade-start.fade-end { -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent); mask-image: linear-gradient(90deg, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent); }
  .sw-tab { all: unset; box-sizing: border-box; position: relative; z-index: 1; flex: none; scroll-snap-align: center; cursor: pointer; display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.8rem; border-radius: 8px; font: 0.76rem var(--zl-font-mono); color: #8896ab; white-space: nowrap; transition: color 0.2s; }
  .sw-tab:hover { color: #e6edf7; }
  .sw-tab[aria-selected='true'] { color: #e6edf7; }
  .sw-tab:focus-visible { outline: 2px solid var(--zl-accent); outline-offset: -2px; }
  .sw-pill { position: absolute; left: 0; top: 0; width: 100px; height: 100px; transform-origin: 0 0; border-radius: 6px; background: rgba(255,255,255,0.1); box-shadow: inset 0 -2px 0 var(--zl-accent); transition: transform 0.45s var(--zl-ease); pointer-events: none; }
  html:not(.zl-js) .sw-pill { display: none; }

  .sw-file { font: 0.7rem var(--zl-font-mono); color: #6b778b; margin: 0.25rem 0 0.5rem; }
  .zl-js .sw-file { display: none; }
  .sw-panel + .sw-panel { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.08); }
  /* With JS: panels stack in one grid cell and crossfade; the cell is sized by the tallest (capped) panel so nothing jumps. */
  .zl-js .sw .zl-win-body { overflow: hidden; }
  .zl-js .sw-panels { display: grid; }
  .zl-js .sw-panel { grid-area: 1 / 1; margin: 0; padding: 0; border: 0; min-width: 0; max-height: min(26rem, 60svh); overflow: auto; overscroll-behavior: contain; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 0.35s var(--zl-ease), transform 0.35s var(--zl-ease), visibility 0s 0.35s; }
  .zl-js .sw-panel.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .sw-panel pre { min-height: 8rem; }
  .sw-panel:not(.is-active) { pointer-events: none; }
  html:not(.zl-js) .sw-panel { max-height: 24rem; overflow: auto; }

  .sw-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: clamp(2rem, 5vw, 3.5rem); }
  @media (max-width: 640px) { .sw-cta .zl-btn { flex: 1 1 100%; } }

  /* Desktop: stacking sticky step cards + progress rail beside a pinned code pane. */
  @media (min-width: 900px) {
    .sw { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 3rem; align-items: start; }
    .sw-col { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 1rem; align-items: start; }
    .sw-prog { display: block; position: sticky; top: 7rem; height: min(18rem, 50svh); margin: 0.5rem 0 0 0.45rem; width: 2px; background: var(--zl-line-strong); border-radius: 2px; }
    .sw-prog-fill { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(var(--zl-accent-hi), var(--zl-accent)); transform-origin: top; transform: scaleY(var(--sw-prog)); transition: transform 0.5s var(--zl-ease); }
    .sw-dot { position: absolute; left: 50%; top: calc(var(--k) * 100%); width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--zl-bg); border: 2px solid var(--zl-line-strong); }
    .sw-dot.is-on { border-color: var(--zl-accent); background: var(--zl-accent); }
    .sw-rail { grid-column: 2; display: block; overflow: visible; padding: 0; -webkit-mask-image: none; mask-image: none; }
    .sw-mdesc { display: none; }
    .sw-step { position: sticky; top: calc(7rem + var(--i) * 0.9rem); margin-bottom: 42svh; padding: 1.25rem 1.4rem 1.4rem; border: 1px solid var(--zl-line); border-radius: var(--zl-radius); background: color-mix(in srgb, var(--zl-bg-2) 96%, var(--zl-accent) 4%); box-shadow: 0 -10px 30px -18px rgba(0,0,0,0.5); transform: scale(0.97); transform-origin: top center; transition: transform 0.45s var(--zl-ease), border-color 0.3s, box-shadow 0.45s; }
    .sw-step > * { opacity: 0.55; transition: opacity 0.45s var(--zl-ease); }
    .sw-step:last-child { margin-bottom: 0; }
    .sw-step[aria-current='step'] { transform: none; border-color: var(--zl-accent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--zl-accent) 35%, transparent), 0 18px 50px -24px var(--zl-accent); }
    .sw-step[aria-current='step'] > * { opacity: 1; }
    .sw-step.is-past > * { opacity: 0.4; }
    html:not(.zl-js) .sw-step { position: static; transform: none; margin-bottom: 1.25rem; }
    html:not(.zl-js) .sw-step > * { opacity: 1; }
    .sw-step-btn { padding: 0; border: 0; background: none !important; font-size: 1.05rem; min-height: 2.75rem; }
    .sw-copy { display: block; margin-top: 0.25rem; max-width: 28rem; }
    .sw-copy h3 { margin: 0 0 0.4rem; font: 600 1.4rem/1.2 var(--zl-font-display); letter-spacing: -0.02em; color: var(--zl-text); }
    .sw-copy p { margin: 0; color: var(--zl-text-2); line-height: 1.6; }
    .sw-pane { position: sticky; top: 6rem; }
    html:not(.zl-js) .sw-pane { position: static; }
    .zl-js .sw-panel { max-height: min(28rem, calc(100svh - 16rem)); }
  }
  @media (min-width: 900px) and (pointer: coarse) {
    .sw-step { position: static; margin-bottom: 1rem; transform: none; }
    .sw-step > * { opacity: 1; }
    .sw-prog { display: none; }
    .sw-col { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sw-step, .sw-step > *, .sw-pill, .sw-prog-fill, .zl-js .sw-panel, .sw-step-btn { transition: none !important; }
    .zl-js .sw-panel { transform: none; }
  }
</style>
