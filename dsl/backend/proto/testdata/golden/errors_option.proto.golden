syntax = "proto3";

package zever.v1;

import "zever/annotations.proto";

option go_package = "github.com/zenta-dev/zever/gen/zeverv1;zeverv1";

message Order {
  string id = 1;
}

message GetOrderRequest {
  string id = 1;
}

service OrderService {
  rpc GetOrder(GetOrderRequest) returns (Order) {
    option (zever.annotations.v1.auth) = { required: true };
    option (zever.annotations.v1.errors) = { cases: [{ code: "NOT_FOUND" }, { code: "INVALID_ARGUMENT", message: "email is malformed" }] };
  }
}
