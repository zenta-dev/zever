// Canonical end-to-end fixture: two entities with a relation declared on
// BOTH sides (User has_many orders / Order belongs_to user) plus two
// services, one with a paginated operation. The two types reference each
// other by bare in-package name, with no import between them and therefore
// no Go import cycle.
//
// Exercised by the backend BenchmarkGenerateAppFixture tests
// (dsl/backend/{atlas,gogen,openapi,proto}) and dsl/compile's own bench;
// keep it compiling under `go test ./dsl/...` when editing.
entity User {
  id: uuid @primary
  email: string @unique
  created_at: timestamp @default(now())

  has_many orders: Order @foreign_key(user_id)
}

entity Order {
  id: uuid @primary
  user_id: uuid
  amount_cents: int64

  belongs_to user: User @foreign_key(user_id)
}

// UserService/OrderService give the gogen backend a real service layer to
// generate from. Adding services here does not affect the zenorm output:
// the zenorm backend only reads schema.Modules[*].Entities.
service UserService {
  rpc GetUser(id: uuid) -> User {
    http: GET "/v1/users/{id}"
    auth: required
  }

  rpc CreateUser(email: string @validate(format: "email")) -> User {
    http: POST "/v1/users"
    auth: required
    errors: { already_exists }
  }
}

service OrderService {
  rpc GetOrder(id: uuid) -> Order {
    http: GET "/v1/orders/{id}"
    auth: required
  }

  rpc CreateOrder(user_id: uuid, amount_cents: int64) -> Order {
    http: POST "/v1/orders"
    auth: required
  }

  // ListOrders exercises the gogen backend's `paginated: true` support.
  rpc ListOrders(user_id: uuid) -> Order {
    http: GET "/v1/orders"
    auth: required
    paginated: true
  }
}