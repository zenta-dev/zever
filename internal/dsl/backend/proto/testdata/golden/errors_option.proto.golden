syntax = "proto3";

package zengo.v1;

import "zengo/annotations.proto";

option go_package = "github.com/zenta-dev/zen-go/gen/zengov1;zengov1";

message Order {
  string id = 1;
}

message GetOrderRequest {
  string id = 1;
}

service OrderService {
  rpc GetOrder(GetOrderRequest) returns (Order) {
    option (zengo.annotations.v1.auth) = { required: true };
    option (zengo.annotations.v1.errors) = { cases: [{ code: "NOT_FOUND" }, { code: "INVALID_ARGUMENT", message: "email is malformed" }] };
  }
}
