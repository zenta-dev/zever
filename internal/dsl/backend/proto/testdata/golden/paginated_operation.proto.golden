syntax = "proto3";

package zengo.v1;

import "google/api/annotations.proto";
import "zengo/annotations.proto";

option go_package = "github.com/zenta-dev/zever/gen/zengov1;zengov1";

message Task {
  string id = 1;
  string title = 2;
}

message ListTasksRequest {
  string user_id = 1;
}

message ListTasksResponse {
  repeated Task items = 1;
  string next_cursor = 2;
}

message GetTaskRequest {
  string id = 1;
}

service TaskService {
  rpc ListTasks(ListTasksRequest) returns (ListTasksResponse) {
    option (google.api.http) = { get: "/v1/tasks" };
    option (zengo.annotations.v1.auth) = { required: true };
  }

  rpc GetTask(GetTaskRequest) returns (Task) {
    option (google.api.http) = { get: "/v1/tasks/{id}" };
    option (zengo.annotations.v1.auth) = { required: true };
  }
}
