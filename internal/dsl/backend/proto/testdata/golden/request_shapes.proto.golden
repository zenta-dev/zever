syntax = "proto3";

package zengo.v1;

import "google/api/annotations.proto";
import "zengo/annotations.proto";

option go_package = "github.com/zenta-dev/zever/gen/zengov1;zengov1";

message Order {
  string id = 1;
}

message LoginRequest {
  string email = 1;
}

message TokenResponse {
  string value = 1;
}

message PutOrderRequest {
  string id = 1;
}

message PatchOrderRequest {
  string id = 1;
}

message SetStatusRequest {
  string id = 1;
  StatusEnum status = 2;

  enum StatusEnum {
    STATUS_UNSPECIFIED = 0;
    STATUS_ACTIVE = 1;
    STATUS_ARCHIVED = 2;
  }
}

message AttachTagRequest {
  Order order = 1;
  string tag_id = 2;
}

service Svc {
  rpc Login(LoginRequest) returns (TokenResponse) {
    option (google.api.http) = { post: "/v1/login" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true };
  }

  rpc PutOrder(PutOrderRequest) returns (Order) {
    option (google.api.http) = { put: "/v1/orders/{id}" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true };
  }

  rpc PatchOrder(PatchOrderRequest) returns (Order) {
    option (google.api.http) = { patch: "/v1/orders/{id}" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true };
  }

  rpc SetStatus(SetStatusRequest) returns (Order) {
    option (google.api.http) = { post: "/v1/orders/{id}/status" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true };
  }

  rpc AttachTag(AttachTagRequest) returns (Order) {
    option (google.api.http) = { post: "/v1/orders/attach" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true };
  }
}
