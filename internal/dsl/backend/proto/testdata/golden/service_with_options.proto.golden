syntax = "proto3";

package zengo.v1;

import "google/api/annotations.proto";
import "zengo/annotations.proto";

option go_package = "github.com/zenta-dev/zever/gen/zengov1;zengov1";

message Order {
  string id = 1;
  string user_id = 2;
  int64 amount_cents = 3;
}

message GetOrderRequest {
  string id = 1;
}

message CreateOrderRequest {
  string user_id = 1;
  int64 amount_cents = 2;
}

message DeleteOrderRequest {
  string id = 1;
}

service OrderService {
  rpc GetOrder(GetOrderRequest) returns (Order) {
    option (google.api.http) = { get: "/v1/orders/{id}" };
    option (zengo.annotations.v1.auth) = { required: true, roles: ["owner", "admin"] };
  }

  rpc CreateOrder(CreateOrderRequest) returns (Order) {
    option (google.api.http) = { post: "/v1/orders" body: "*" };
    option (zengo.annotations.v1.auth) = { required: true, roles: ["owner"] };
    option (zengo.annotations.v1.permission) = { check: "owns_order", resource: "Order", owner_field: "user_id" };
  }

  rpc DeleteOrder(DeleteOrderRequest) returns (Order) {
    option (google.api.http) = { delete: "/v1/orders/{id}" };
    option (zengo.annotations.v1.auth) = { required: true };
  }
}
